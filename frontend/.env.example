# SoloSaathi Circle — Frontend Environment Configuration
# Copy this file to .env.local for local development.

# Base URL for the Netlify Functions backend API.
# In local development with Netlify CLI (`netlify dev`), this typically routes through:
# http://localhost:8888/.netlify/functions
#
# When running pure Vite dev server (`npm run dev`) alongside a local Netlify function server:
VITE_API_BASE_URL=http://localhost:8888/.netlify/functions

# Demo mode is always on for test details (no setting needed): WhatsApp 9000000000–9000000999
# with OTP 123456, and organizer venue IDs starting with DEMO- (DEMO-UNIT / demo1234) are answered
# in the browser by src/api/mockApi.js. Everything else goes to the backend.
# To send every request to the demo backend, use `npm run frontend:mock` (sets this via .env.mock):
# VITE_USE_MOCK_API=true

# Venue SOS WhatsApp number with country code, e.g. 919876543210. The SOS button on the circle
# page is hidden when this is unset.
# VITE_SOS_WHATSAPP=

# In Production on Netlify:
# Leave this unset or configure in Netlify Dashboard Site Settings > Environment Variables.
# If left relative, calls will hit /.netlify/functions directly on the deployed domain.
