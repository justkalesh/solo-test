# SoloSaathi Circle — Backend Environment Variables
# Copy this file to .env in the project root for local Netlify Functions execution.

# Admin secret: signs organizer session tokens and protects the admin-only finalize-bucket
# endpoint. Organizers log in with their own accounts (npm run create-organizer).
ADMIN_SECRET=solosaathi_dev_admin_secret_2026

# Test environments only: lets ADMIN_SECRET log into any venue dashboard. Leave unset in production.
# ALLOW_MASTER_ADMIN_LOGIN=true

# Signs the attendee session from verify-otp (needed by find-my-circle, circle-actions, get-circle).
# Use a long random value, different from the other secrets.
ATTENDEE_SESSION_SECRET=solosaathi_dev_attendee_session_secret_32bytes

# Browser origin allowed to call the functions (CORS), e.g. https://solosaathi.in.
# Unset means '*', which is only for local development.
# ALLOWED_ORIGIN=https://your-production-domain

# WhatsApp Business API (BSP)
WHATSAPP_API_KEY=your_whatsapp_bsp_api_key
WHATSAPP_API_URL=https://api.whatsapp.com/v1/messages

# Google Gemini Flash API (for ticket verification OCR)
GEMINI_API_KEY=your_gemini_api_key
# Optional: override the Gemini model (defaults to gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash

# Razorpay Payment Gateway (Live or Test Mode keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Cryptographic token signing secret for verified tickets
TICKET_TOKEN_SECRET=solosaathi_ticket_token_secret_key_32bytes

# Firebase Service Account JSON (stringified JSON for Cloud Firestore access)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"...","client_email":"..."}

# Developer Flags
# Set OTP_DEV_MODE=true to print OTP codes directly to server console instead of sending real WhatsApp/SMS
OTP_DEV_MODE=true

# (Optional) SMS Fallback Provider
# SMS_API_KEY=
# SMS_API_URL=
# SMS_DLT_TEMPLATE_ID=
